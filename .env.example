# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT
JWT_SECRET=change_me_to_random_secret_32chars
JWT_EXPIRE_HOURS=24

# First admin
FIRST_ADMIN_EMAIL=your_email@example.com

# Public API Keys
SEOUL_BUS_API_KEY=your_seoul_api_key
GYEONGGI_BUS_API_KEY=your_gyeonggi_api_key

# DB
DATABASE_URL=sqlite:///./bus_arrival.db
